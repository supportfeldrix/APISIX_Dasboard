<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Log Files Cleanup Report</title>
</head>
<body style="font-family: Arial, sans-serif; background-color: #ffffff; margin: 0; padding: 20px; color: #333;">
    <div style="max-width: 600px; margin: auto; border: 1px solid #ddd; border-radius: 6px; padding: 20px; background-color: #ffffff;">

        <!-- Header -->
        <h2 style="color: #0073e6; margin-top: 0; text-align: center; font-size: 26px;">Log Files Cleanup Report</h2>

        <!-- Divider -->
        <hr style="border: none; border-top: 1px solid #eee; margin: 15px 0;">

        <!-- Intro -->
        <p style="font-size: 14px; margin-bottom: 15px;">
            The following log files older than 30 days were found in
            <strong style="color:#0073e6;">{{ source_dir }}</strong>:
        </p>

        <!-- Divider -->
        <hr style="border: none; border-top: 1px solid #eee; margin: 10px 0;">

        <!-- File List -->
        <div style="background-color: #f9f9f9; padding: 10px; border-radius: 4px;">
            <ul style="padding-left: 20px; margin: 0; font-size: 14px; color: #555;">
            {% for file in old_logs.files %}
                <li style="padding: 6px 0; border-bottom: 1px solid #eee;">{{ file.path }}</li>
            {% endfor %}
            </ul>
        </div>

        <!-- Divider -->
        <hr style="border: none; border-top: 1px solid #eee; margin: 15px 0;">

        <!-- Summary -->
        <p style="margin-top: 10px; font-size: 16px; font-weight: bold; text-align: center;">
            <span style="background-color: #28a745; color: #fff; padding: 8px 14px; border-radius: 4px;">
                Total log files removed: {{ old_logs.files | length }}
            </span>
        </p>

        <!-- Divider -->
        <hr style="border: none; border-top: 1px solid #eee; margin: 15px 0;">

        <!-- Footer -->
        <div style="font-size: 12px; color: #777; text-align: center; padding: 10px 0;">
            Report generated on {{ ansible_date_time.date }} at {{ ansible_date_time.time }}.
        </div>
    </div>
</body>
</html>