# =============================================================================
# APISIX Dashboard - PRODUCTION Configuration
# =============================================================================

# --- Authentication ---
# IMPORTANT: Generate a unique strong secret (32+ chars) - DO NOT reuse UAT value
JWT_SECRET=CHANGE-ME-GENERATE-A-STRONG-RANDOM-SECRET-FOR-PROD
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=30

# --- APISIX Admin API ---
# TODO: Update with PROD APISIX Admin API URL (internal pod IP or service DNS)
APISIX_ADMIN_BASE_URL=http://CHANGE-ME-PROD-APISIX-IP:9180
APISIX_ADMIN_KEY=CHANGE-ME-PROD-APISIX-ADMIN-KEY
APISIX_ADMIN_VERIFY_SSL=false
APISIX_ADMIN_TIMEOUT=10

# --- Prometheus Metrics ---
# TODO: Update with PROD metrics endpoint
APISIX_METRICS_URL=http://CHANGE-ME-apisix-metrics.cro-apisix-prod.svc.cluster.local:9091/apisix/prometheus/metrics
APISIX_METRICS_TIMEOUT=10

# --- Database ---
DATABASE_URL=sqlite:///./apisix_dashboard.db

# --- Server ---
# TODO: Update with PROD dashboard route URL
CORS_ORIGINS=https://CHANGE-ME-cro-apisix-croit-dashboard-prod.apps.CLUSTER.DOMAIN
ROOT_PATH=
LOG_LEVEL=INFO

# --- OpenShift / Kubernetes API ---
OC_API_SERVER=https://CHANGE-ME-api.CLUSTER.DOMAIN:6443
OC_TOKEN=CHANGE-ME-SA-TOKEN
OC_NAMESPACE=CHANGE-ME-cro-apisix-prod
OC_VERIFY_SSL=false

# --- LDAP ---
LDAP_ENABLED=true
LDAP_SERVER=ldaps://ldap.fnbconnect.co.za:636
LDAP_BASE_DN=DC=fnb,DC=co,DC=za
LDAP_USER_FILTER=(&(objectClass=user)(sAMAccountName={username}))
LDAP_BIND_DN=SVC_cro_ansible_dev@fnb.co.za
LDAP_BIND_PASSWORD=CHANGE-ME-LDAP-PASSWORD
LDAP_GROUP_BASE_DN=OU=GlobalSecurityGroups,OU=DomainGroups,DC=fnb,DC=co,DC=za
LDAP_ADMIN_GROUP=
LDAP_USE_SSL=true
LDAP_VERIFY_SSL=false

# --- SMTP (Email Notifications) ---
SMTP_HOST=mail.fnb.co.za
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=cromonitor@fnb.co.za
SMTP_USE_TLS=true
SMTP_VERIFY_SSL=false

# --- Notification Scheduler ---
NOTIFICATION_EVAL_INTERVAL=60
NOTIFICATION_LOG_RETENTION_DAYS=90

# --- Version Check ---
GITHUB_API_TIMEOUT=15
GITHUB_PROXY_URL=http://htf-cobbler.fnb.co.za:8080
VERSION_CHECK_INTERVAL_HOURS=24

# --- Application Environment ---
APP_ENVIRONMENT=PROD
