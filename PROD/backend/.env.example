# Authentication
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=30

# APISIX Admin API
APISIX_ADMIN_BASE_URL=
APISIX_ADMIN_KEY=
APISIX_ADMIN_VERIFY_SSL=true
APISIX_ADMIN_TIMEOUT=10

# Prometheus Metrics
APISIX_METRICS_URL=
APISIX_METRICS_TIMEOUT=10

# SMTP (Email Notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_USE_TLS=true

# Notification Scheduler
NOTIFICATION_EVAL_INTERVAL=60
NOTIFICATION_LOG_RETENTION_DAYS=90

# Version Check
GITHUB_API_TIMEOUT=15
GITHUB_PROXY_URL=http://htf-cobbler.fnb.co.za:8080
VERSION_CHECK_INTERVAL_HOURS=24

# Application Environment (UAT or PROD)
APP_ENVIRONMENT=PROD

# Database
DATABASE_URL=sqlite:///./apisix_dashboard.db

# Server
CORS_ORIGINS=http://localhost:5173
ROOT_PATH=
LOG_LEVEL=INFO
